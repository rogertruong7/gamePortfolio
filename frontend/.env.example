# Copy to .env for local development. Never give these a VITE_ prefix, because
# Vite would publish them in the site's public JavaScript.

# The password for /admin.
ADMIN_PASSWORD=

# Neon connection string for the analytics database.
DATABASE_URL=

# Web3Forms key for the contact form, from web3forms.com. Unlike the variables above, this one
# is meant to be public, so it has the VITE_ prefix to reach the site's JavaScript.
VITE_WEB3FORMS_ACCESS_KEY=
